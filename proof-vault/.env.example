# --- Database ---
# Proof Vault requires PostgreSQL 14+ (RLS + gen_random_uuid()/pgcrypto).
DATABASE_URL=postgres://proofvault:proofvault@localhost:5432/proofvault

# --- App ---
PORT=4000
NODE_ENV=development

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-64-char-random-hex-string
SESSION_COOKIE_MAX_AGE_MS=86400000

# --- Evidence storage (Phase 2) ---
# "local" (default) writes to STORAGE_LOCAL_DIR on disk -- no external
# service needed. "s3" talks to AWS S3 or any S3-compatible service
# (MinIO, etc.) -- set the S3_* vars below when using it.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/evidence
MAX_UPLOAD_BYTES=26214400

# --- S3 (only used when STORAGE_DRIVER=s3) ---
S3_BUCKET=
S3_REGION=us-east-1
# Set for MinIO / any non-AWS S3-compatible endpoint; leave unset for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave both unset on AWS to use the SDK's default credential chain
# (IAM role, shared config, etc.) instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers (Phase 6 — all optional, all disabled by default) ---
AI_PROVIDER=mock
AI_MONTHLY_BUDGET_USD=0
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
